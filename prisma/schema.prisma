// RONDA — Schema MVP
// "30 segundos para presentarte. 5 minutos para conocerse."

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Nota: SQLite no soporta enums nativos → se usan strings tipados en código.

model User {
  id         String   @id @default(cuid())
  // email interno generado (el MVP no pide email al usuario)
  email      String   @unique
  name       String
  age        Int
  city       String
  gender     String   // FEMALE | MALE | NON_BINARY
  lookingFor String   // RELATIONSHIP | MEET_PEOPLE | FRIENDSHIP
  preference String   // WOMEN | MEN | EVERYONE
  interests  String   @default("[]") // JSON array de strings
  bio        String?
  photoUrl   String?
  videoUrl   String?
  // AVAILABLE | WAITING | IN_ROUND | ROUND_ENDED | CONNECTED
  status     String   @default("AVAILABLE")
  isDemo     Boolean  @default(false)
  // email | google | tiktok (google/tiktok solo visual en MVP, nunca autentica)
  provider   String   @default("email")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sessions        Session[]
  roundsAsA       Round[]         @relation("roundUserA")
  roundsAsB       Round[]         @relation("roundUserB")
  connectionsAsA  Connection[]    @relation("connUserA")
  connectionsAsB  Connection[]    @relation("connUserB")
  messages        Message[]
  reportsMade     Report[]        @relation("reporter")
  reportsReceived Report[]        @relation("reported")
  eventSignups    EventAttendee[]
  blocksMade      Block[]         @relation("blocker")
  blocksReceived  Block[]         @relation("blocked")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Round {
  id        String    @id @default(cuid())
  userAId   String // usuario real que entra a la ronda
  userBId   String // pareja asignada (demo u otro usuario)
  status    String    @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  // WANT_MORE | GOOD_VIBES | NEXT
  choiceA   String?
  choiceB   String?
  createdAt DateTime  @default(now())

  userA User @relation("roundUserA", fields: [userAId], references: [id])
  userB User @relation("roundUserB", fields: [userBId], references: [id])
}

model Connection {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  roundId   String?
  // ACTIVE (match) | PENDING (segunda oportunidad, futuro) | ENDED
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  userA    User      @relation("connUserA", fields: [userAId], references: [id])
  userB    User      @relation("connUserB", fields: [userBId], references: [id])
  messages Message[]
}

model Message {
  id           String   @id @default(cuid())
  connectionId String
  senderId     String
  content      String
  createdAt    DateTime @default(now())

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sender     User       @relation(fields: [senderId], references: [id])
}

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  emoji       String
  description String
  dateLabel   String
  capacity    Int      @default(20)
  createdAt   DateTime @default(now())

  attendees EventAttendee[]
}

model EventAttendee {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reportedId String
  reason     String // INAPPROPRIATE | HARASSMENT | FAKE_PROFILE | OTHER | BLOCK
  details    String?
  status     String   @default("OPEN") // OPEN | REVIEWED
  createdAt  DateTime @default(now())

  reporter User @relation("reporter", fields: [reporterId], references: [id])
  reported User @relation("reported", fields: [reportedId], references: [id])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Icebreaker {
  id    String @id @default(cuid())
  text  String @unique
  order Int    @default(0)
}
